set autoindent
set indicator
set smarthome
set softwrap
set zap

set titlecolor black,lightcyan
set selectedcolor black,lightcyan
set spotlightcolor black,lightyellow
set statuscolor black,lightcyan
set numbercolor cyan
set stripecolor black,lightcyan
set scrollercolor lightcyan
set keycolor lightcyan
set functioncolor lightcyan

include "/usr/share/nano/*.nanorc"

bind ^Z suspend main

unbind M-J main
unbind M-T main
